<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Ask Google Play services to fetch the OCR model at install time, so
             the first scan doesn't stall waiting on an on-demand model download.
             Merged into the host app manifest by the Android manifest merger. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
    </application>
</manifest>
